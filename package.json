{
  "name": "zapped",
  "productName": "zapped",
  "version": "1.0.2",
  "private": true,
  "description": "zapped — un test de mecanografía animado y personalizable, también como app de escritorio.",
  "author": {
    "name": "euZAPUS",
    "url": "https://github.com/euZAPUS"
  },
  "homepage": "https://github.com/euZAPUS/zapped",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/euZAPUS/zapped.git"
  },
  "license": "UNLICENSED",
  "type": "module",
  "main": "desktop/dist/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p desktop/tsconfig.json --noEmit",
    "test": "vitest run",
    "screenshots": "node scripts/screenshots.mjs",
    "desktop:compile": "tsc -p desktop/tsconfig.json",
    "desktop": "npm run build && npm run desktop:compile && electron .",
    "desktop:pack": "npm run build && npm run desktop:compile && electron-builder --dir",
    "desktop:dist": "npm run build && npm run desktop:compile && electron-builder --publish never",
    "notices": "node scripts/third-party-notices.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@fontsource/fira-code": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inconsolata": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "@fontsource/source-code-pro": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
